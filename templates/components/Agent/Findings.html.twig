{# Shown through the present_findings interrupt. Pin and exclude buttons are answered by
   the research controller, which owns the user's part of the state; the two choices
   resume the run. #}
<div class="agent-component my-3 overflow-hidden rounded-2xl border border-indigo-200 bg-white shadow-sm dark:border-indigo-900 dark:bg-slate-900"
     data-interrupt data-controller="findings">
    <div class="border-b border-indigo-100 bg-indigo-50 px-4 py-3 dark:border-indigo-900 dark:bg-indigo-950/50">
        <div class="text-xs font-semibold uppercase tracking-wide text-indigo-700 dark:text-indigo-300">{{ 'findings.title'|trans({'%round%': round}) }}</div>
        {% if summary %}<p class="mt-1 text-sm text-slate-700 dark:text-slate-300">{{ summary }}</p>{% endif %}
        <p class="mt-1 text-[11px] text-slate-500 dark:text-slate-400">{{ 'findings.help'|trans }}</p>
    </div>

    {% for group in groups %}
        <section class="px-4 pt-3">
            <h3 class="text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">{{ group.axis.id|upper }} · {{ group.axis.title }}</h3>
            {% for principle in group.principles %}
                <article class="mt-2 rounded-xl border border-slate-200 p-3 dark:border-slate-700" data-principle="{{ principle.id }}">
                    <div class="flex items-start gap-2">
                        <span class="stance stance-{{ principle.stance }}">{{ principle.stanceLabel }}</span>
                        <p class="flex-1 text-sm font-medium text-slate-900 dark:text-slate-100">{{ principle.statement }}</p>
                        <button type="button" class="pin-button"
                                data-action="research#togglePrinciple"
                                data-research-id-param="{{ principle.id }}"
                                data-pin-principle="{{ principle.id }}">📌 {{ 'findings.pin_principle'|trans }}</button>
                    </div>
                    <ul class="mt-2 divide-y divide-slate-100 dark:divide-slate-800">
                        {% for decision in principle.decisions %}
                            <li class="py-2" data-decision="{{ decision.id }}">
                                <div class="flex items-start gap-2">
                                    <div class="min-w-0 flex-1">
                                        <a href="{{ this.url(decision.id) }}" target="_blank" rel="noopener noreferrer"
                                           class="text-sm font-semibold text-slate-900 hover:text-indigo-700 dark:text-slate-100 dark:hover:text-indigo-300">{{ decision.citation }}</a>
                                        <div class="mt-1 flex flex-wrap gap-1.5 text-[11px]">
                                            <span class="stance stance-{{ decision.stance }}">{{ decision.stanceLabel }}</span>
                                            {% if decision.solution %}<span class="badge">{{ decision.solution }}</span>{% endif %}
                                            {% for publication in decision.publications %}
                                                <span class="badge badge-indigo">{{ publication }}</span>
                                            {% else %}
                                                <span class="badge">{{ 'decision.unpublished'|trans }}</span>
                                            {% endfor %}
                                        </div>
                                        {% if decision.relevance %}<p class="mt-1 text-sm text-slate-700 dark:text-slate-300">{{ decision.relevance }}</p>{% endif %}
                                        {% if decision.summary %}
                                            <details class="mt-1 text-xs text-slate-500 dark:text-slate-400">
                                                <summary class="cursor-pointer select-none">{{ 'decision.summary'|trans }}</summary>
                                                <p class="mt-1">{{ decision.summary }}</p>
                                            </details>
                                        {% endif %}
                                    </div>
                                    <div class="flex shrink-0 flex-col gap-1">
                                        <button type="button" class="pin-button"
                                                data-action="research#toggleDecision"
                                                data-research-id-param="{{ decision.id }}"
                                                data-research-title-param="{{ decision.citation }}"
                                                data-research-note-param="{{ decision.relevance }}"
                                                data-pin-decision="{{ decision.id }}">📌 {{ 'decision.pin'|trans }}</button>
                                        <button type="button" class="exclude-button"
                                                data-action="research#toggleExclusion"
                                                data-research-id-param="{{ decision.id }}"
                                                data-exclude-decision="{{ decision.id }}">🚫 {{ 'decision.exclude'|trans }}</button>
                                    </div>
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                </article>
            {% endfor %}
        </section>
    {% endfor %}

    <div class="mt-3 border-t border-slate-100 bg-slate-50 px-4 py-3 dark:border-slate-800 dark:bg-slate-800/40" data-interrupt-control>
        <textarea rows="2" data-findings-target="instruction" data-action="input->findings#write"
                  placeholder="{{ 'findings.instruction_placeholder'|trans }}" class="plan-input"></textarea>
        <div class="mt-2 flex flex-wrap gap-2">
            <button type="button" data-findings-target="choice"
                    data-action="agent-chat#chose ag-ui#resume"
                    data-ag-ui-action-param="continue" data-ag-ui-instruction-param=""
                    class="rounded-xl border border-indigo-400 px-4 py-1.5 text-sm font-medium text-indigo-700 hover:bg-white disabled:opacity-50 dark:text-indigo-300 dark:hover:bg-slate-800">
                🔁 {{ 'findings.continue'|trans }}
            </button>
            <button type="button" data-findings-target="choice"
                    data-action="agent-chat#chose ag-ui#resume"
                    data-ag-ui-action-param="write" data-ag-ui-instruction-param=""
                    class="rounded-xl bg-indigo-600 px-4 py-1.5 text-sm font-medium text-white hover:bg-indigo-500 disabled:opacity-50">
                ✍️ {{ 'findings.write'|trans }}
            </button>
        </div>
    </div>
</div>
