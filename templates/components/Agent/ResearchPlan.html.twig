{# Shown through the propose_research_plan interrupt. The research-plan controller keeps
   the edited brief and axes in the validate button's `plan` param. #}
<div class="agent-component my-3 rounded-2xl border border-amber-300 bg-amber-50 p-4 dark:border-amber-700 dark:bg-amber-950/40"
     data-interrupt data-controller="research-plan">
    <div class="flex items-baseline justify-between gap-2">
        <div class="text-xs font-semibold uppercase tracking-wide text-amber-700 dark:text-amber-400">
            {{ (complementary ? 'plan.complementary_title' : 'plan.title')|trans }}
        </div>
        {% if title and not complementary %}<div class="text-xs text-slate-500 dark:text-slate-400">{{ title }}</div>{% endif %}
    </div>

    {% if complementary %}
        {% if previousAxes is not empty %}
            <p class="mt-2 text-xs text-slate-600 dark:text-slate-300">{{ 'plan.previous_axes'|trans }} {{ previousAxes|join(' · ') }}</p>
        {% endif %}
    {% else %}
        <div class="mt-3 rounded-xl bg-white/80 p-3 dark:bg-slate-900/60">
            <div class="text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">{{ 'brief.title'|trans }}</div>
            {% for field in ['facts', 'issue', 'side', 'goal'] %}
                <label class="mt-2 block text-xs font-medium text-slate-600 dark:text-slate-300">{{ ('brief.' ~ field)|trans }}</label>
                <textarea rows="{{ field == 'facts' ? 3 : 1 }}" data-research-plan-target="brief" data-field="{{ field }}" data-action="input->research-plan#collect"
                          class="plan-input grow-input">{{ brief[field] ?? '' }}</textarea>
            {% endfor %}
        </div>
    {% endif %}

    <div class="mt-3 text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">{{ 'plan.axes'|trans }}</div>
    <ol class="mt-1 space-y-2" data-research-plan-target="axes">
        {% for axis in axes %}
            <li class="flex items-start gap-2" data-research-plan-target="axis">
                <div class="flex-1 space-y-1">
                    <textarea rows="1" data-role="title" data-action="input->research-plan#collect" class="plan-input grow-input font-medium">{{ axis.title }}</textarea>
                    <textarea rows="1" data-role="objective" placeholder="{{ 'plan.objective'|trans }}" data-action="input->research-plan#collect" class="plan-input grow-input text-xs">{{ axis.objective }}</textarea>
                </div>
                <button type="button" data-action="research-plan#remove" title="{{ 'plan.remove_axis'|trans }}" data-interrupt-control
                        class="mt-1 rounded-lg px-2 py-1 text-xs text-slate-400 hover:bg-white hover:text-rose-600 dark:hover:bg-slate-800">✕</button>
            </li>
        {% endfor %}
    </ol>
    <template data-research-plan-target="template">
        <li class="flex items-start gap-2" data-research-plan-target="axis">
            <div class="flex-1 space-y-1">
                <textarea rows="1" data-role="title" placeholder="{{ 'plan.new_axis'|trans }}" data-action="input->research-plan#collect" class="plan-input grow-input font-medium"></textarea>
                <textarea rows="1" data-role="objective" placeholder="{{ 'plan.objective'|trans }}" data-action="input->research-plan#collect" class="plan-input grow-input text-xs"></textarea>
            </div>
            <button type="button" data-action="research-plan#remove" title="{{ 'plan.remove_axis'|trans }}" data-interrupt-control
                    class="mt-1 rounded-lg px-2 py-1 text-xs text-slate-400 hover:bg-white hover:text-rose-600 dark:hover:bg-slate-800">✕</button>
        </li>
    </template>
    <button type="button" data-action="research-plan#add" data-interrupt-control
            class="mt-2 rounded-lg border border-dashed border-amber-400 px-3 py-1 text-xs text-amber-800 hover:bg-white dark:text-amber-300 dark:hover:bg-slate-800">
        + {{ 'plan.add_axis'|trans }}
    </button>

    <div class="mt-3 rounded-xl bg-white/70 px-3 py-2 text-xs text-slate-600 dark:bg-slate-900/50 dark:text-slate-300">
        {% for line in filters %}<div>{{ line }}</div>{% endfor %}
    </div>

    <div class="mt-3 flex flex-wrap gap-2" data-research-plan-target="choices" data-interrupt-control>
        <button type="button"
                data-research-plan-target="approve"
                data-action="agent-chat#chose ag-ui#resume"
                data-ag-ui-approved-param="true"
                data-ag-ui-plan-param="{}"
                class="rounded-xl bg-amber-500 px-4 py-1.5 text-sm font-medium text-white hover:bg-amber-400 disabled:opacity-50">
            ✓ {{ 'plan.approve'|trans }}
        </button>
        <button type="button" data-action="research-plan#edit"
                class="rounded-xl border border-amber-400 px-3 py-1.5 text-sm text-amber-800 hover:bg-white disabled:opacity-50 dark:text-amber-300 dark:hover:bg-slate-800">
            {{ 'plan.edit'|trans }}
        </button>
    </div>

    <div class="mt-3 hidden" data-research-plan-target="instruction" data-interrupt-control>
        <textarea rows="2" data-research-plan-target="feedback" data-action="input->research-plan#write"
                  placeholder="{{ 'plan.instruction_placeholder'|trans }}" class="plan-input"></textarea>
        <button type="button" data-research-plan-target="send"
                data-action="agent-chat#chose ag-ui#resume"
                data-ag-ui-approved-param="false"
                data-ag-ui-feedback-param=""
                disabled
                class="mt-2 rounded-xl bg-amber-500 px-3 py-1.5 text-sm font-medium text-white hover:bg-amber-400 disabled:opacity-50">
            {{ 'plan.send_instruction'|trans }}
        </button>
    </div>
</div>
