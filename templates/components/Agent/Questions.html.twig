{# Shown through the ask_questions interrupt. The questions controller keeps the answers
   in the button's params; ag-ui#resume sends them. #}
<div class="agent-component my-3 rounded-2xl border border-sky-300 bg-sky-50 p-4 dark:border-sky-800 dark:bg-sky-950/40"
     data-interrupt data-controller="questions">
    <div class="text-xs font-semibold uppercase tracking-wide text-sky-700 dark:text-sky-400">
        {{ ('questions.title.' ~ purpose)|trans }}
    </div>
    {% if intro %}<p class="mt-1 text-sm text-slate-700 dark:text-slate-300">{{ intro }}</p>{% endif %}

    <div class="mt-3 space-y-4">
        {% for question in questions %}
            <fieldset class="space-y-1.5" data-questions-target="question" data-id="{{ question.id }}" data-type="{{ question.type }}">
                <legend class="text-sm font-medium text-slate-900 dark:text-slate-100">{{ question.label }}</legend>
                {% if question.type == 'text' or question.options is empty %}
                    <textarea rows="2" data-action="input->questions#collect"
                              class="mt-1 w-full rounded-xl border border-sky-200 bg-white p-2 text-sm text-slate-900 dark:border-sky-800 dark:bg-slate-900 dark:text-slate-100"></textarea>
                {% else %}
                    <div class="flex flex-wrap gap-2">
                        {% for option in question.options %}
                            <label class="choice-chip">
                                <input type="{{ question.type == 'multiple' ? 'checkbox' : 'radio' }}" name="{{ question.id }}" value="{{ option }}"
                                       data-action="change->questions#collect" class="sr-only peer">
                                <span>{{ option }}</span>
                            </label>
                        {% endfor %}
                    </div>
                {% endif %}
            </fieldset>
        {% endfor %}
        <div>
            <label class="text-xs text-slate-500 dark:text-slate-400">{{ 'questions.comment'|trans }}</label>
            <textarea rows="2" data-questions-target="comment" data-action="input->questions#collect"
                      class="mt-1 w-full rounded-xl border border-sky-200 bg-white p-2 text-sm text-slate-900 dark:border-sky-800 dark:bg-slate-900 dark:text-slate-100"></textarea>
        </div>
    </div>

    <div class="mt-3 flex justify-end" data-interrupt-control>
        <button type="button"
                data-questions-target="submit"
                data-action="agent-chat#chose ag-ui#resume"
                data-ag-ui-answers-param="{}"
                data-ag-ui-comment-param=""
                class="rounded-xl bg-sky-600 px-4 py-1.5 text-sm font-medium text-white hover:bg-sky-500 disabled:opacity-50">
            {{ 'questions.submit'|trans }}
        </button>
    </div>
</div>
