<header class="flex items-center justify-between gap-4 border-b border-slate-200 bg-white px-4 py-3 dark:border-slate-800 dark:bg-slate-950">
    <div class="flex min-w-0 items-center gap-3">
        <a href="{{ path('research') }}" class="shrink-0 text-base font-semibold text-slate-900 dark:text-slate-100">⚖️ {{ 'app.title'|trans }}</a>
        {% block header_title %}{% endblock %}
    </div>
    {% block header_center %}{% endblock %}
    <form method="post" action="{{ path('logout') }}" class="flex shrink-0 items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
        <span class="hidden lg:inline">{{ app.user.userIdentifier }}</span>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
        <button type="submit" class="underline underline-offset-2 hover:text-slate-800 dark:hover:text-slate-200">{{ 'login.logout'|trans }}</button>
    </form>
</header>
