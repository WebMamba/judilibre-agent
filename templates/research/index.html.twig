{% extends 'base.html.twig' %}

{% block body_class %}h-full flex flex-col{% endblock %}

{% block body %}
{# One root for the chat and the side panels: pin buttons in the cards and edits in the
   panels bubble up to the research controller, which owns the shared state. research
   and agent-chat come before ag-ui, to be listening when it connects. #}
<div class="flex-1 min-h-0 flex flex-col"
     data-controller="research agent-chat ag-ui"
     data-ag-ui-endpoint-value="{{ path('agent_stream') }}"
     data-agent-chat-waiting-value="{{ 'chat.waiting'|trans }}"
     data-action="
        ag-ui:connect->research#connected
        ag-ui:state-changed->research#stateChanged
        research:state->ag-ui#setState
        research:filters-changed->research#filtersChanged
        ag-ui:run-started->agent-chat#runStarted
        ag-ui:run-finished->agent-chat#runFinished
        ag-ui:run-error->agent-chat#runError
        ag-ui:error->agent-chat#error
        ag-ui:idle->agent-chat#idle
        ag-ui:text-message-start->agent-chat#textStart
        ag-ui:text-message-content->agent-chat#textContent
        ag-ui:text-message-end->agent-chat#textEnd
        ag-ui:tool-call-start->agent-chat#toolCallStart
        ag-ui:tool-call-args->agent-chat#toolCallArgs
        ag-ui:tool-call-end->agent-chat#toolCallEnd
        ag-ui:tool-call-result->agent-chat#toolCallResult
        ag-ui:activity-changed->agent-chat#activityChanged
     ">
    <header class="flex items-center justify-between border-b border-slate-200 bg-white px-4 py-3 dark:border-slate-800 dark:bg-slate-950">
        <div>
            <h1 class="text-base font-semibold text-slate-900 dark:text-slate-100">⚖️ {{ 'app.title'|trans }}</h1>
            <p class="text-xs text-slate-500 dark:text-slate-400">{{ 'app.subtitle'|trans }}</p>
        </div>
        <button type="button" data-action="research#restart"
                class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800">
            {{ 'app.new_search'|trans }}
        </button>
    </header>

    <main class="flex-1 min-h-0 flex flex-col gap-3 p-3 md:flex-row">
        <section class="panel flex-1 min-h-0 min-w-0 flex flex-col overflow-hidden !p-0">
            <div data-agent-chat-target="messages" class="flex-1 min-h-0 overflow-y-auto px-4 py-4 space-y-5">
                <div data-agent-chat-target="placeholder" class="mx-auto max-w-xl py-10 text-center text-sm text-slate-500 dark:text-slate-400">
                    <p class="text-base text-slate-700 dark:text-slate-300">{{ 'chat.welcome'|trans }}</p>
                    <p class="mt-2">{{ 'chat.suggestion'|trans }}</p>
                </div>
            </div>

            <form data-action="submit->agent-chat#send submit->ag-ui#send" class="border-t border-slate-200 p-3 dark:border-slate-800">
                <div class="flex items-end gap-2 rounded-xl border border-slate-300 bg-white p-1.5 focus-within:border-indigo-500 dark:border-slate-700 dark:bg-slate-900">
                    <textarea data-agent-chat-target="input"
                              data-ag-ui-target="input"
                              data-action="keydown.enter->agent-chat#maybeSend"
                              rows="2"
                              placeholder="{{ 'chat.placeholder'|trans }}"
                              required
                              class="flex-1 resize-none bg-transparent px-2 py-1.5 text-sm text-slate-900 placeholder-slate-400 focus:outline-none dark:text-slate-100 dark:placeholder-slate-500"></textarea>
                    <button type="submit" data-agent-chat-target="submit" title="{{ 'chat.send'|trans }}"
                            class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-indigo-600 text-white hover:bg-indigo-500 disabled:cursor-not-allowed disabled:opacity-40">
                        <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6"/></svg>
                    </button>
                </div>
                <p class="mt-2 text-center text-[10px] text-slate-400 dark:text-slate-500">{{ 'chat.disclaimer'|trans }}</p>
            </form>
        </section>

        <aside class="flex w-full shrink-0 flex-col gap-3 overflow-y-auto md:w-80">
            <twig:FiltersPanel id="filters-panel" />
            <twig:DossierPanel id="dossier-panel" />
        </aside>
    </main>

    {# Server-rendered components with no slot in the conversation land here. #}
    <div data-controller="ag-ui-activities"></div>

    <template data-agent-chat-target="userTemplate">
        <div class="flex justify-end">
            <div class="max-w-[85%] whitespace-pre-wrap rounded-2xl rounded-br-sm bg-indigo-600 px-3 py-2 text-sm text-white" data-role="text"></div>
        </div>
    </template>

    <template data-agent-chat-target="assistantTemplate">
        <div class="max-w-3xl">
            {# Text, tool lines and components, in the order their events arrive. #}
            <div class="text-sm" data-role="body"></div>
        </div>
    </template>
</div>
{% endblock %}
