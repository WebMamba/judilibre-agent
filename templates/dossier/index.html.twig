{% extends 'base.html.twig' %}

{% block title %}{{ 'dossiers.title'|trans }} · {{ 'app.title'|trans }}{% endblock %}

{% block body %}
{% embed '_header.html.twig' %}{% endembed %}
<main class="mx-auto w-full max-w-4xl px-4 py-8">
    <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <h1 class="text-2xl font-semibold text-slate-900 dark:text-slate-100">{{ 'dossiers.title'|trans }}</h1>
            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">{{ 'dossiers.intro'|trans }}</p>
        </div>
        <a href="{{ path('dossier_new') }}" class="rounded-xl bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-500">+ {{ 'dossiers.new'|trans }}</a>
    </div>

    <ol class="mt-6 grid gap-2 text-xs sm:grid-cols-4">
        {% for step in ['qualification', 'plan', 'recherche', 'redaction'] %}
            <li class="rounded-xl border border-slate-200 bg-white p-3 dark:border-slate-800 dark:bg-slate-900">
                <div class="font-semibold text-slate-800 dark:text-slate-100">{{ loop.index }}. {{ ('dossiers.how.' ~ step ~ '.title')|trans }}</div>
                <p class="mt-1 text-slate-500 dark:text-slate-400">{{ ('dossiers.how.' ~ step ~ '.text')|trans }}</p>
            </li>
        {% endfor %}
    </ol>

    <ul class="mt-6 space-y-2">
        {% for dossier in dossiers %}
            <li class="panel flex flex-wrap items-center gap-3" data-controller="rename">
                <a href="{{ path('dossier_show', {id: dossier.id}) }}" class="min-w-0 flex-1" data-rename-target="link">
                    <div class="truncate font-medium text-slate-900 dark:text-slate-100">{{ dossier.title ?: 'dossiers.untitled'|trans }}</div>
                    <div class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">
                        {{ ('phase.' ~ dossier.phase)|trans }} · {{ 'dossiers.updated'|trans }} {{ dossier.updatedAt|date('d/m/Y H:i') }}
                    </div>
                </a>
                <form method="post" action="{{ path('dossier_rename', {id: dossier.id}) }}" class="hidden w-full items-center gap-2 sm:w-auto" data-rename-target="form">
                    <input type="hidden" name="_token" value="{{ csrf_token('dossier') }}">
                    <input type="text" name="title" value="{{ dossier.title }}" required maxlength="160"
                           class="rounded-lg border border-slate-300 bg-white px-2 py-1 text-sm dark:border-slate-700 dark:bg-slate-900">
                    <button class="rounded-lg bg-indigo-600 px-3 py-1 text-xs text-white">{{ 'dossiers.save'|trans }}</button>
                </form>
                <button type="button" data-action="rename#edit" data-rename-target="button"
                        class="text-xs text-slate-500 underline underline-offset-2 hover:text-slate-800 dark:hover:text-slate-200">{{ 'dossiers.rename'|trans }}</button>
            </li>
        {% else %}
            <li class="rounded-xl border border-dashed border-slate-300 p-8 text-center text-sm text-slate-500 dark:border-slate-700 dark:text-slate-400">{{ 'dossiers.empty'|trans }}</li>
        {% endfor %}
    </ul>
</main>
{% endblock %}
