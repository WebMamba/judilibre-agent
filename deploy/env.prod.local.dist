# Copy to .env.prod.local at the root of the clone on the VPS, then: chmod 600 .env.prod.local
# Single quotes: some values contain "$".

# The domain; its DNS A record points to this VPS. Caddy gets the certificate.
SERVER_NAME=jurisprudence.example.fr

# openssl rand -hex 32
APP_SECRET=

ANTHROPIC_API_KEY=

# The PISTE API key of the production application (36 characters, a UUID).
JUDILIBRE_KEY_ID=

# JSON: e-mail => password hash. On any machine with the project:
#   php bin/console security:hash-password 'Symfony\Component\Security\Core\User\InMemoryUser'
APP_USERS='{"juriste@example.fr":"$2y$13$..."}'
